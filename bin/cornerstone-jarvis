#!/usr/bin/env python3
"""CLI control client for cornerstone-jarvis daemon.

Usage:
  cornerstone-jarvis listen           # start/stop voice capture -> agy
  cornerstone-jarvis ask "prompt..."  # send text prompt -> agy
  cornerstone-jarvis stop             # stop listening / thinking / speaking
  cornerstone-jarvis reset            # clear thread & start fresh
  cornerstone-jarvis wake [on|off|toggle]
  cornerstone-jarvis tts [on|off|toggle]
  cornerstone-jarvis status           # print current state JSON
"""
import json
import os
import socket
import subprocess
import sys
import time

SOCK_PATH = os.path.expanduser("~/.local/state/cornerstone-jarvis/jarvis.sock")


def ensure_daemon():
    if os.path.exists(SOCK_PATH):
        return
    subprocess.run(
        ["systemctl", "--user", "start", "cornerstone-jarvis.service"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
    )
    for _ in range(30):
        if os.path.exists(SOCK_PATH):
            return
        time.sleep(0.1)


def send(cmd: str, arg: str = "") -> dict:
    ensure_daemon()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5.0)
    s.connect(SOCK_PATH)
    s.sendall(json.dumps({"cmd": cmd, "arg": arg}).encode("utf-8"))
    data = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        data += chunk
        if b"\n" in chunk:
            break
    s.close()
    return json.loads(data.decode("utf-8"))


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        sys.exit(1)
    cmd = sys.argv[1].lower()
    arg = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""
    try:
        res = send(cmd, arg)
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        sys.exit(1)
    print(json.dumps(res))
    if not res.get("ok"):
        sys.exit(1)


if __name__ == "__main__":
    main()
