[Unit]
Description=Cornerstone local STT (Whisper large-v3-turbo, faster-whisper CPU int8)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/storage/files/dictation
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/mnt/storage/files/dictation/venv/bin/python /mnt/storage/files/dictation/app/stt_server.py --model-dir /mnt/storage/files/dictation/models/large-v3-turbo --vocab-file /home/kushbeaverttv/.config/omarchy/dictation-cornerstone/vocabulary.txt --port 29333 --threads 24
Restart=on-failure
RestartSec=3
MemoryMax=8G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
