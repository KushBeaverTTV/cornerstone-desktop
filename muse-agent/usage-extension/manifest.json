{
  "manifest_version": 3,
  "name": "Muse Usage for Omarchy",
  "version": "1.0.0",
  "description": "Reads your Muse quota from muse.ai settings and shows it in the Omarchy bar. Sends nothing anywhere else.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://muse.ai/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
